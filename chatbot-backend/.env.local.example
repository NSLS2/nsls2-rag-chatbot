# Backend environment example (local variant)
APP_NAME=Generic RAG Chatbot Backend
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
PORT=8000


# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=default_docs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:3.8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=128

# Generation and Retrieval Settings
SNIPPET_MAX_CHARS=4000
GENERATION_TIMEOUT_MS=30000
GENERATION_ENFORCE_TIMEOUT=true
DEFAULT_TOP_K=5

# Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# User Agent for API requests
USER_AGENT=chatbot-backend/0.1.0 (contact: hbishai1@bnl.gov)

# Feature Flags
ENABLE_STREAMING=true

# Database (Required - use DATABASE_URL directly)
DATABASE_URL=postgresql+psycopg://raguser:ragpass@localhost:5432/ragdb

QUERY_EMBED_CACHE_SIZE=1000

# Optional: Allow PHP execution in file processing
ALLOW_PHP_EXEC=false
